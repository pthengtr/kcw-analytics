# Environment template (copy to .env — gitignored)

# Required for BATs
KCW_ANALYTICS_PYTHON=C:\ProgramData\anaconda3\python.exe
# KCW_ANALYTICS_LOG_DIR=G:\Shared drives\KCW-Data\kcw_analytics\04_outputs\90_logs\daily_logs
# Prefer the Shared Drive letter path (not a resolved DriveFS AppData path):
# KCW_DRIVE_ROOT=G:\Shared drives
# Linux rclone (this HQ box): KCW_DRIVE_ROOT=/home/hqadmin/mnt/gdrive
# Or set the analytics folder explicitly:
# KCW_ANALYTICS_DATA_ROOT=G:\Shared drives\KCW-Data\kcw_analytics
# KCW_ANALYTICS_DATA_ROOT=/home/hqadmin/mnt/gdrive/KCW-Data/kcw_analytics

# Supabase (TAR / loaders) — Postgres DSN, NOT the https://....supabase.co API URL
# SUPABASE_DB_URL=postgresql://postgres.jdzitzsucntqbjvwiwxm:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# or component form used by notebooks:
# SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.jdzitzsucntqbjvwiwxm
# DB_PASSWORD=   # or SUPABASE_DB_PASSWORD=

# HQ PARTS9 extract (SQL auth). Prefer env over notebook hardcoding.
# PARTS9_HQ_SERVER=KSS.local,KSS,192.168.1.99
# PARTS9_HQ_DATABASE=PARTS9
# PARTS9_HQ_USER=python_reader
# PARTS9_HQ_PASSWORD=
#
# Linux HQ only: PARTS9 Picture share (same host list, probe TCP 445 — not a pinned LAN IP).
# KSS_SMB_HOST=KSS.local,KSS,192.168.1.99
# KSS_SMB_SHARE=KAcc9
# KSS_SMB_USER=
# KSS_SMB_PASSWORD=

# SYP PARTS9 extract
# Windows SYP PC: trusted auth, PARTS9_SYP_SERVER=KSS-PC (local).
# Linux HQ box: SQL auth over Tailscale (same python_reader as HQ). Do not
# wait for SYP Task Scheduler — HQ A/B runs extract --site syp first.
# PARTS9_SYP_SERVER=kss-pc
# PARTS9_SYP_DATABASE=PARTS9
# PARTS9_SYP_USER=python_reader
# PARTS9_SYP_PASSWORD=
# PARTS9_SYP_FULL_EXTRACT=0
