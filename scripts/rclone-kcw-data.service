[Unit]
Description=rclone mount Google Shared Drive KCW-Data
Documentation=https://github.com/pthengtr/kcw-docs/blob/main/ops/hq-linux.md
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p %h/mnt/gdrive/KCW-Data
ExecStart=%h/.local/bin/rclone mount "kcw,team_drive=0AJ5BTDhgit7-Uk9PVA:" %h/mnt/gdrive/KCW-Data --config %h/.config/rclone/rclone.conf --vfs-cache-mode writes --dir-cache-time 10s --umask 022
ExecStop=/usr/bin/fusermount3 -u %h/mnt/gdrive/KCW-Data
Restart=on-failure
RestartSec=15
TimeoutStartSec=90

[Install]
WantedBy=default.target
